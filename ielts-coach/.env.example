# AI provider: deepseek (default) or anthropic. No key => demo mode (nothing saved, no spend).
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Per-user daily essay checks (stored in DB)
IELTS_DAILY_ASSESS_LIMIT=5
# Supabase (Project Settings > API). Service role key is SERVER ONLY - never prefix with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: better photo/handwriting reading via a vision model (Anthropic). Without it, photos are read in the browser.
# OCR_ANTHROPIC_API_KEY=
# OCR_MODEL=claude-haiku-5-5
# IELTS_DAILY_OCR_LIMIT=10
# AI image reading for handwriting (any ONE of these). Auto-detected in this order; force with OCR_PROVIDER=gemini|openai|anthropic.
# GEMINI_API_KEY=            # Google AI Studio key; free tier available
# OPENAI_API_KEY=
